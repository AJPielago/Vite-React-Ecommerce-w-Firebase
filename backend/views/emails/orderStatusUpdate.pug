extends baseEmail

block content
  p Hi #{firstName},
  p Your order status has been updated to: 
    strong #{order.status.toUpperCase()}
  
  p 
    | Order ID: 
    strong #{order._id}
  p 
    | Order Date: 
    strong #{new Date(order.createdAt).toLocaleDateString()}
  
  h3 Order Summary:
  table(style="width: 100%; border-collapse: collapse; margin: 25px 0;")
    thead
      tr(style="background-color: #f8f9fa;")
        th(style="padding: 12px; text-align: left; border-bottom: 1px solid #ddd;") Item
        th(style="padding: 12px; text-align: right; border-bottom: 1px solid #ddd;") Quantity
        th(style="padding: 12px; text-align: right; border-bottom: 1px solid #ddd;") Price
        th(style="padding: 12px; text-align: right; border-bottom: 1px solid #ddd;") Total
    tbody
      each item in order.orderItems
        tr(style="border-bottom: 1px solid #eee;")
          td(style="padding: 12px; border-bottom: 1px solid #eee;") 
            | #{item.name}
            if item.product
              br
              small(style="color: #666;") SKU: #{item.product}
          td(style="padding: 12px; text-align: right; border-bottom: 1px solid #eee;") #{item.quantity}
          td(style="padding: 12px; text-align: right; border-bottom: 1px solid #eee;") $#{item.price.toFixed(2)}
          td(style="padding: 12px; text-align: right; border-bottom: 1px solid #eee;") $#{(item.price * item.quantity).toFixed(2)}
    tfoot
      tr
        td(colspan="3" style="padding: 12px; text-align: right; font-weight: bold;") Subtotal:
        td(style="padding: 12px; text-align: right; font-weight: bold;") $#{order.itemsPrice.toFixed(2)}
      
      if order.taxPrice > 0
        tr
          td(colspan="3" style="padding: 12px; text-align: right;") Tax:
          td(style="padding: 12px; text-align: right;") $#{order.taxPrice.toFixed(2)}
      
      if order.shippingPrice > 0
        tr
          td(colspan="3" style="padding: 12px; text-align: right;") Shipping:
          td(style="padding: 12px; text-align: right;") $#{order.shippingPrice.toFixed(2)}
      
      tr(style="border-top: 2px solid #000;")
        td(colspan="3" style="padding: 12px; text-align: right; font-weight: bold; font-size: 1.1em;") Total:
        td(style="padding: 12px; text-align: right; font-weight: bold; font-size: 1.1em;") $#{order.totalPrice.toFixed(2)}
  
  if order.status === 'shipped' && order.trackingNumber
    p 
      | Your order has been shipped with tracking number: 
      strong #{order.trackingNumber}
    p You can track your order using the following link:
    a(href=`${process.env.CLIENT_URL}/tracking/${order._id}`) Track My Order
  
  p If you have any questions about your order, please reply to this email or contact our support team.
  p Thank you for shopping with us!
  p - The #{process.env.APP_NAME} Team
